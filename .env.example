# ========================================================
# ENVIRONMENT VARIABLES FOR WEB PAGE SERVICE DEPLOYMENT
# ========================================================

# 1. Cloud Database (Supabase or Neon PostgreSQL)
# Copy the pooled connection string from Supabase (Database -> Connection Pooling) or Neon
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# 2. Admin Security Password
# Used to unlock the /admin.html dashboard and protect your ICCID stock
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# 3. Automated Email Notifications (Resend API)
# Get a free API key at https://resend.com
RESEND_API_KEY=re_123456789abcdef

# 4. Email where you want to receive new top-up alerts
NOTIFICATION_EMAIL=orders@yourdomain.com
FROM_EMAIL="SIM Orders <onboarding@resend.dev>"

# 5. Local Port (default: 3000)
PORT=3000
